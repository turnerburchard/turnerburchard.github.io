<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for page in site.html_pages %}
  {%- unless page.url == "/404.html" or page.name contains "google" %}
  <url><loc>{{ page.url | absolute_url }}</loc></url>
  {%- endunless %}
{%- endfor %}
{%- for post in site.posts %}
  <url><loc>{{ post.url | absolute_url }}</loc></url>
{%- endfor %}
  {%- comment %} Deployed from the paludarium repo, so Jekyll doesn't know about it. {% endcomment %}
  <url><loc>https://turnerburchard.com/paludarium/</loc></url>
</urlset>
